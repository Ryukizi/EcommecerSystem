@page "/produto/{Id:long}"
@inject IProdutoService ProdutosServices
@inject CarrinhoService CarrinhoService
@inject NavigationManager Navigation

<div class="container my-5">
    @if (produto == null)
    {
        @if (carregando)
        {
            <div class="text-center my-5">
                <div class="spinner-border text-warning" role="status"></div>
                <p class="mt-2 text-muted">A carregar detalhes da guitarra...</p>
            </div>
        }
        else
        {
            <div class="alert alert-danger text-center" role="alert">
                Guitarra não encontrada no nosso catálogo. 🎸
            </div>
            <div class="text-center">
                <a href="/" class="btn btn-primary">Voltar à Loja</a>
            </div>
        }
    }
    else
    {
        <div class="row g-5">
            <div class="col-md-6 text-center">
                <div class="p-4 bg-dark rounded-3 shadow-sm d-flex align-items-center justify-content-center" style="min-height: 400px;">
                    @if (!string.IsNullOrEmpty(produto.Url_imagem))
                    {
                        <img src="@produto.Url_imagem" class="img-fluid rounded" alt="@produto.Nome" style="max-height: 400px; object-fit: contain;" />
                    }
                    else
                    {
                        <div class="text-muted">
                            <span class="display-1">🎸</span>
                            <p class="mt-2">Sem imagem disponível</p>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-6 d-flex flex-column justify-content-between">
                <div>
                    <span class="badge bg-warning text-dark mb-2">@produto.Marca</span>
                    <h1 class="fw-bold text-light mb-3">@produto.Nome</h1>

                    <div class="mb-4">
                        @if (produto.Quantidade > 0)
                        {
                            <span class="badge bg-success">Disponível em Stock</span>
                            <span class="text-muted small ms-2">(@produto.Quantidade unidades disponíveis)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Esgotado</span>
                        }
                    </div>

                    <hr class="border-secondary" />

                    <div class="my-4">
                        <h2 class="text-success fw-bold">R$ @produto.Preco.ToString("N2", new CultureInfo("pt-BR"))</h2>
                        <p class="text-muted">
                            ou até <strong>12x de R$ @((produto.Preco / 12).ToString("N2", new CultureInfo("pt-BR")))</strong> sem juros no cartão
                        </p>
                    </div>

                    @* <p class="text-muted mt-3">@produto.Descricao</p> *@
                </div>

                <div class="d-grid gap-3 mt-4">
                    @if (produto.Quantidade > 0)
                    {
                        <button class="btn btn-success btn-lg rounded-pill py-3 fw-bold shadow-sm" @onclick="AdicionarAoCarrinho">
                            Adicionar ao Carrinho 🛒
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-lg rounded-pill py-3 fw-bold" disabled>
                            Indisponível 🚫
                        </button>
                    }

                    <a href="/" class="btn btn-outline-light btn-lg rounded-pill py-3">
                        Voltar para a Loja
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public long Id { get; set; }

    private ProdutosCadastradosDto? produto;
    private bool carregando = true;

    protected override async Task OnParametersSetAsync()
    {
        carregando = true;
        produto = null;

        try
        {
            produto = await ProdutosServices.GetProdutoByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar detalhes do produto: {ex.Message}");
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task AdicionarAoCarrinho()
    {
        if (produto == null) return;

        // Mapeia o DTO de volta para a entidade que o CarrinhoService espera
        var guitarraEntity = new Guitarras
        {
            Id = produto.Id,
            Nome = produto.Nome,
            Marca = produto.Marca,
            Preco = produto.Preco,
            Url_imagem = produto.Url_imagem,
            Quantidade = produto.Quantidade
        };

        await CarrinhoService.Adicionar(guitarraEntity);

        // Redireciona o utilizador diretamente para o carrinho para ver a sua nova guitarra!
        Navigation.NavigateTo("/carrinho");
    }
}