@page "/carrinho"
@using Validacao.Shared.Dtos
@using Validacao.Shared.Models
@using Validacao.Web.Services

@inject CarrinhoService CarrinhosServices
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider


<div class="container my-4">
    <h2>🛒 Seu Carrinho de Compras</h2>

    @if (itensCarrinho == null)
    {
        <div class="text-center mt-4">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Carregando seu carrinho seguro...</p>
        </div>
    }
    else if (itensCarrinho.Count == 0)
    {
        <div class="alert alert-info mt-4">
            O seu carrinho está vazio. Que tal voltar e escolher uma guitarra? 🎸
        </div>
        <a href="/" class="btn btn-primary">Voltar à Loja</a>
    }
    else
    {
        <div class="row g-5 mt-2">
            <div class="col-lg-8">
                @foreach (var item in itensCarrinho)
                {
                    @if (item != null)
                    {
                        <div class="card mb-3 shadow-sm border-0 bg-dark text-light rounded-3">
                            <div class="row g-0 align-items-center p-3">
                                <div class="col-md-2 text-center">
                                    @if (!string.IsNullOrEmpty(item.Url_imagem))
                                    {
                                        <a href="/produto/@item.Id" class="text-decoration-none text-dark">
                                            <img src="@item.Url_imagem" class="img-fluid rounded" alt="@item.Nome" style="max-height: 80px; object-fit: contain;" />
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height: 80px; width: 80px; margin: auto;">
                                            <span class="text-light small">Sem foto</span>
                                        </div>
                                    }
                                </div>

                                <div class="col-md-6 px-3">
                                    <h5 class="card-title fw-bold text-warning mb-1">@item.Nome</h5>
                                    <p class="card-text text-muted small mb-0">Marca: @item.Marca</p>
                                </div>

                                <div class="col-md-2 text-end">
                                    <span class="fw-bold fs-5 text-success">R$ @item.Preco.ToString("N2")</span>
                                </div>

                                <div class="col-md-2 text-center">
                                    <button class="btn btn-outline-danger btn-sm rounded-pill px-3" @onclick="() => RemoverDoCarrinho(item.Id)">
                                        ✕ Remover
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 bg-dark text-light p-4 rounded-3">
                    <h4 class="fw-bold text-warning border-bottom pb-3 mb-3">Resumo do Pedido</h4>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold text-uppercase">Calcular Frete</label>
                        <div class="d-flex gap-2">
                            <input class="form-control form-control-sm bg-secondary text-light border-0 rounded-pill px-3"
                                   type="text" placeholder="00000-000" @bind="cep" @bind:event="oninput" maxlength="9" />
                            <button class="btn btn-warning btn-sm rounded-pill px-3 fw-bold" @onclick="ConsultarFreteProdutoAsync" disabled="@loading">
                                @if (loading)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                }
                                else
                                {
                                    <span>Calcular</span>
                                }
                            </button>
                        </div>

                        @if (resultadoFrete != null)
                        {
                            <div class="mt-3 p-3 bg-secondary rounded-3 text-start small">
                                <p class="text-warning fw-bold mb-2">Enviar para: @resultadoFrete.Cidade/@resultadoFrete.Estado</p>

                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="freteOption" id="frete-pac"
                                           checked="@(tipoFreteSelecionado == "PAC")"
                                           @onchange='() => { SelecionarTipoFrete("PAC", resultadoFrete.ValorPac); }' />
                                    <label class="form-check-label text-light cursor-pointer" for="frete-pac">
                                        <strong>PAC (Econômico)</strong> <br />
                                        <span class="text-success fw-bold">R$ @resultadoFrete.ValorPac.ToString("N2")</span> — @resultadoFrete.PrazoPac
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="freteOption" id="frete-sedex"
                                           checked="@(tipoFreteSelecionado == "SEDEX")"
                                           @onchange='() => { SelecionarTipoFrete("SEDEX", resultadoFrete.ValorSedex); }' />
                                    <label class="form-check-label text-light cursor-pointer" for="frete-sedex">
                                        <strong>SEDEX (Expresso)</strong> <br />
                                        <span class="text-success fw-bold">R$ @resultadoFrete.ValorSedex.ToString("N2")</span> — @resultadoFrete.PrazoSedex
                                    </label>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="border-top pt-3">
                        <div class="d-flex justify-content-between small text-muted mb-2">
                            <span>Subtotal:</span>
                            <span>R$ @totalCarrinho.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between small text-muted mb-3">
                            <span>Frete:</span>
                            <span class="text-success">
                                @if (valorFreteSelecionado > 0)
                                {
                                    <span>R$ @valorFreteSelecionado.ToString("N2")</span>
                                }
                                else
                                {
                                    <span>R$ 0,00</span>
                                }
                            </span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-5">Total Geral:</span>
                            <span class="fw-bold fs-4 text-success">R$ @((totalCarrinho + valorFreteSelecionado).ToString("N2"))</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button class="btn btn-success rounded-pill py-2 fw-bold" @onclick="FinalizarCompra" disabled="@(valorFreteSelecionado == 0)">
                            Finalizar Compra 🚀
                        </button>

                        @if (valorFreteSelecionado == 0)
                        {
                            <small class="text-danger text-center">Calcule o CEP e escolha uma opção de frete para avançar.</small>
                        }

                        <a href="/" class="btn btn-outline-light rounded-pill py-2 mt-1">
                            Continuar a Comprar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string cep = "";
    private bool loading = false;

    private RespostaFreteDto? resultadoFrete;

    private string tipoFreteSelecionado = "";
    private decimal valorFreteSelecionado = 0;

    private List<Guitarras>? itensCarrinho = null;
    private decimal totalCarrinho = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await CarrinhosServices.CarregarCarrinhoAsync();
                itensCarrinho = CarrinhosServices.Itens?.ToList() ?? new List<Guitarras>();
                totalCarrinho = CarrinhosServices.Total;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro crítico ao inicializar o carrinho: {ex.Message}");
                itensCarrinho = new List<Guitarras>();
                StateHasChanged();
            }
        }
    }

    private async Task RemoverDoCarrinho(long Id)
    {
        await CarrinhosServices.Remover(Id);
        itensCarrinho = CarrinhosServices.Itens.ToList();
        totalCarrinho = CarrinhosServices.Total;
        ResetarFrete();
    }

    private void SelecionarTipoFrete(string tipo, decimal valor)
    {
        tipoFreteSelecionado = tipo;
        valorFreteSelecionado = valor;
    }

    private void ResetarFrete()
    {
        tipoFreteSelecionado = "";
        valorFreteSelecionado = 0;
    }

    private async Task FinalizarCompra()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/finalizar-compra");
        }
        else
        {
            Navigation.NavigateTo("/cadastro");
        }
    }

    private async Task ConsultarFreteProdutoAsync()
    {
        if (string.IsNullOrWhiteSpace(cep)) return;

        loading = true;
        resultadoFrete = null;
        ResetarFrete();

        try
        {
            // 💡 Olha que lindo e limpo! A UI só pede o dado, sem saber de rotas HTTP
            resultadoFrete = await CarrinhosServices.CalcularFreteAsync(cep);
        }
        finally
        {
            loading = false;
        }
    }
}