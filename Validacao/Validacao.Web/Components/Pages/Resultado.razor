@page "/resultados"
@using Validacao.Application.Interfaces
@using Validacao.Shared.Dtos
@using System.Net.Http.Json
@using System.Globalization
@inject IProdutoService ProdutosServices
@inject HttpClient httpClient
@inject NavigationManager Navigation

<div class="container-fluid my-4 py-3">
    <h2 class="mb-4 text-center text-warning py-3">Resultados da Busca 🎸</h2>

    @if (guitarrasFiltradas == null)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-warning" role="status"></div>
            <p class="mt-2 text-muted">Buscando guitarras no catálogo...</p>
        </div>
    }
    else if (!guitarrasFiltradas.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            Nenhuma guitarra foi encontrada para o termo "<strong>@termoBusca</strong>". Tente buscar por outra marca ou modelo!
        </div>
    }
    else
    {
        <div class="row row-cols-lg-5 justify-content-center g-4">
            @foreach (var item in guitarrasFiltradas)
            {
                <div class="col-md-4 mb-4 px-md-3">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(item.Url_imagem))
                        {
                            <a href="/produto/@item.Id" class="text-decoration-none text-dark">
                                <img src="@item.Url_imagem" class="card-img-top p-3" alt="@item.Nome" style="max-height: 250px; object-fit: contain;" />
                            </a>
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                                <span class="text-muted">Sem imagem</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <a href="/produto/@item.Id" class="text-decoration-none text-dark">
                                    <h5 class="card-title fw-bold">@item.Nome</h5>
                                </a>
                                <p class="card-text mb-2 text-muted"><strong>Marca:</strong> @item.Marca</p>

                                @if (item.Quantidade > 0)
                                {
                                    <p class="card-text mb-3 text-secondary">
                                        <span class="badge bg-success">Em estoque</span> @item.Quantidade unidade.
                                    </p>
                                }
                                else
                                {
                                    <p class="card-text mb-3 text-danger fw-bold">
                                        <span class="badge bg-danger">Esgotado</span>
                                    </p>
                                }
                            </div>

                            <a href="/produto/@item.Id" class="text-decoration-none text-dark">
                                <h4 class="card-text text-success fw-bold mt-2">
                                    R$ @item.Preco.ToString("N2", new CultureInfo("pt-BR"))
                                </h4>
                            </a>
                            <p class="card-text text-muted small">
                                ou 12x de R$ @((item.Preco / 12).ToString("N2", new CultureInfo("pt-BR"))) sem juros
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>>

@code {
    // Lista para renderizar na tela
    private List<ProdutosCadastradosDto>? guitarrasFiltradas = null;

    // Captura automaticamente o termo "busca" que vem na URL
    [Parameter]
    [SupplyParameterFromQuery(Name = "busca")]
    public string? termoBusca { get; set; }

    // Este método roda automaticamente sempre que a página carrega ou a URL muda
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            guitarrasFiltradas = null; // Ativa o spinner
            Console.WriteLine($"[BLAZOR] 🌐 Enviando requisição HTTP para a API buscando por: '{termoBusca}'");

            var url = $"api/Produtos/buscar?termo={Uri.EscapeDataString(termoBusca ?? "")}";
            guitarrasFiltradas = await httpClient.GetFromJsonAsync<List<ProdutosCadastradosDto>>(url);

            if (guitarrasFiltradas != null)
            {
                Console.WriteLine($"[BLAZOR] ✅ Resposta recebida! {guitarrasFiltradas.Count} guitarras prontas para renderizar.");
            }
            else
            {
                Console.WriteLine("[BLAZOR] ⚠️ Resposta recebida, mas a lista veio NULA.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[BLAZOR] ❌ FALHA na requisição HTTP: {ex.Message}");
            guitarrasFiltradas = new List<ProdutosCadastradosDto>();
        }
        finally
        {
            StateHasChanged();
        }
    }
}
