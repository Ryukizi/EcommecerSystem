@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-3">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold fs-4 text-warning d-flex align-items-center gap-2" href="/">
            <span>🎸</span> GuitarShop
        </a>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-center gap-3 mt-3 mt-lg-0">

                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item dropdown dropdown-hover">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-light"
                               id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center text-white fw-bold" style="width: 28px; height: 28px; font-size: 0.9rem;">
                                    @context.User.Identity?.Name?[..1].ToUpper()
                                </div>
                                <span class="fw-medium">@context.User.Identity?.Name</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" href="/dashboard">📋 Minha Conta</a></li>
                                <li><a class="dropdown-item" href="/compras">🛍️ Compras</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><button class="dropdown-item text-danger" @onclick="ExecutarLogout">🚪 Sair</button></li>
                            </ul>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <div class="d-flex gap-2">
                                <a href="/login" class="btn btn-sm btn-outline-light px-3 rounded-pill">Login</a>
                                <a href="/cadastro" class="btn btn-sm btn-warning px-3 fw-bold rounded-pill">Cadastrar</a>
                            </div>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>

                <li class="nav-item">
                    <a href="/carrinho" class="btn btn-warning position-relative d-flex align-items-center gap-2 rounded-pill px-3 py-2 fw-bold shadow-sm">
                        <span>🛒</span>
                        <span>Carrinho</span>
                    </a>
                </li>

                <li>
                    <form class="d-flex" role="search" @onsubmit="DispararBusca">
                        <input class="form-control me-2" type="search" placeholder="Buscar guitarra..." aria-label="Search" @bind="termoPesquisa" />
                        <button class="btn btn-outline-warning" type="submit">Search</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>

@code{
    private string termoPesquisa = "";
    private string _respostaBasica = "";
    private async Task ExecutarLogout()
    {
        try
        {
            await ((SupabaseAuthStateProvider)AuthStateProvider).FazerLogout();

            Navigation.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            _respostaBasica = $"Erro ao deslogar: {ex.Message}";
        }
    }

    private void DispararBusca()
    {
        if (!string.IsNullOrWhiteSpace(termoPesquisa))
        {
            Navigation.NavigateTo($"/resultados?busca={Uri.EscapeDataString(termoPesquisa)}");
        }
    }
}