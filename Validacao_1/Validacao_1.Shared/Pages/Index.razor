@page "/"
@inject ProdutoService ProdutosServices

<div class="d-flex justify-content-between align-items-center p-3 mb-4 bg-dark text-white rounded shadow-sm">
    <h3 class="m-0">🎸 GuitarShop</h3>

    <AuthorizeView>
        <Authorized>
            <a href="/dashboard" class="btn btn-outline-light d-flex align-items-center gap-2 rounded-pill px-3">
                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    👤
                </div>
                <span>@context.User.Identity?.Name</span>
            </a>
        </Authorized>
        <NotAuthorized>
            <div class="d-flex gap-2">
                <a href="/login" class="btn btn-sm btn-outline-light">Login</a>
                <a href="/cadastro" class="btn btn-sm btn-light">Cadastrar</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div class="container my-4">
    <h2 class="mb-4 text-center">Nosso Catálogo de Guitarras 🎸</h2>

    @if (!string.IsNullOrEmpty(_respostaBasica))
    {
        <div class="alert alert-danger" role="alert">
            @_respostaBasica
        </div>
    }

    <div class="row">
        @foreach (var item in produtos)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(item.Url_imagem))
                    {
                        <img src="@item.Url_imagem" class="card-img-top p-3" alt="@item.Nome" style="max-height: 250px; object-fit: contain;" />

                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                            <span class="text-muted">Sem imagem</span>
                        </div>
                    }

                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <a href="/produto/@item.Id" class="text-decoration-none text-dark">
                                <h5 class="card-title fw-bold">@item.Nome</h5>
                            </a>
                            <p class="card-text mb-2 text-muted"><strong>Marca:</strong> @item.Marca</p>

                            @if (item.Quantidade > 0)
                            {
                                <p class="card-text mb-3 text-secondary">
                                    <span class="badge bg-success">Em estoque</span> @item.Quantidade un.
                                </p>
                            }
                            else
                            {
                                <p class="card-text mb-3 text-danger fw-bold">
                                    <span class="badge bg-danger">Esgotado</span>
                                </p>
                            }
                        </div>

                        <h4 class="card-text text-success fw-bold mt-2">
                            R$ @item.Preco.ToString("N2")
                        </h4>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string _respostaBasica = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            produtos = await ProdutosServices.GetProdutosAsync();
        }
        catch (Exception ex)
        {
            _respostaBasica = $"Erro ao obter produtos: {ex.Message}";
        }
    }

    private List<Guitarras> produtos = new List<Guitarras>();
}
