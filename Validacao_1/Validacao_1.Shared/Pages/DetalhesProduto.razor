@page "/produto/{Id:long}"
@inject ProdutoService ProdutosServices
@inject NavigationManager Navigation
@inject CarrinhoService CarrinhosServices
@inject HttpClient Http

<div class="container-fluid bg-dark text-light min-vh-100 py-5">
    <div class="container">
        @if (produto == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-warning" role="status"></div>
                <p class="mt-2 text-muted">Carregando detalhes do produto...</p>
            </div>
        }
        else
        {
            <div class="row g-5 align-items-start">

                <div class="col-md-6">
                    <div class="row g-2 align-items-start">

                        <div class="col-2 d-flex flex-column gap-2 align-items-center">
                            @if (!string.IsNullOrEmpty(produto.Url_imagem))
                            {
                                <button class="btn p-0 border border-warning rounded overflow-hidden" style="height: 60px; width: 60px;">
                                    <img src="@produto.Url_imagem" class="img-fluid" style="object-fit: cover; height: 100%; width: 100%;" />
                                </button>
                            }

                            <button class="btn p-0 border border-secondary rounded text-muted d-flex align-items-center justify-content-center" style="height: 60px; width: 60px; font-size: 20px;">
                            </button>
                        </div>

                        <div class="col-10 text-center">
                            <div class="rounded p-3 d-inline-block">
                                @if (!string.IsNullOrEmpty(produto.Url_imagem))
                                {
                                    <img src="@produto.Url_imagem" class="img-fluid rounded" alt="@produto.Nome" style="max-height: 450px; object-fit: contain;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center" style="height: 400px;">
                                        <span class="text-light">Sem foto disponível</span>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                </div>

                <div class="col-md-6">
                    <span class="text-muted small uppercase">Categoria: Guitarras</span>
                    <h1 class="fw-bold text-light mt-1 mb-3">@produto.Nome</h1>

                    <div class="mb-4">
                        <p class="text-muted mb-1">Marca: <span class="text-light fw-semibold">@produto.Marca</span></p>
                    </div>

                    <div class="my-4">
                        <h2 class="text-success fw-bold mb-0">R$ @produto.Preco.ToString("N2") <span class="fs-6 text-muted fw-normal">no PIX</span></h2>
                        <p class="text-muted small mt-1">ou R$ @((produto.Preco * 1.11m).ToString("N2")) em 10x sem juros</p>
                    </div>

                    <div class="d-grid gap-2 col-lg-8 mt-4">
                        <button class="btn btn-success btn-lg rounded-3 fw-bold py-3" @onclick="AdicionarAoCarrinho">
                            🛒 Comprar
                        </button>
                    </div>

                    <div class="mb-4 mt-4 col-lg-8">
                        <div class="d-flex">
                            <input class="form-control form-control-sm me-2 rounded-2 bg-secondary text-light border-secondary px-3"
                                   type="text" placeholder="Calcular CEP" @bind="cep" maxlength="9" style="max-width: 150px;" />
                            <button class="btn btn-outline-warning btn-sm px-3" type="button" @onclick="ConsultarFreteProdutoAsync" disabled="@loading">
                                @if (loading)
                                {
                                    <span class="spinner-border spinner-border-sm" role="status"></span>
                                }
                                else
                                {
                                    <span>Buscar</span>
                                }
                            </button>
                        </div>

                        @if (resultadoFrete != null)
                        {
                            <div class="mt-3 p-3 bg-secondary rounded-3 small border border-secondary" style="max-width: 350px;">
                                <p class="text-warning mb-2 fw-bold">Frete para: @resultadoFrete.Cidade - @resultadoFrete.Estado</p>

                                <div class="d-flex justify-content-between mb-1 text-light">
                                    <span>🚚 PAC (Econômico):</span>
                                    <span class="text-success fw-bold">R$ @resultadoFrete.ValorPac.ToString("N2")</span>
                                </div>
                                <div class="text-muted mb-2 ps-3" style="font-size: 0.8rem;">Prazo estimado: @resultadoFrete.PrazoPac</div>

                                <div class="d-flex justify-content-between mb-1 text-light">
                                    <span>⚡ SEDEX (Expresso):</span>
                                    <span class="text-success fw-bold">R$ @resultadoFrete.ValorSedex.ToString("N2")</span>
                                </div>
                                <div class="text-muted ps-3" style="font-size: 0.8rem;">Prazo estimado: @resultadoFrete.PrazoSedex</div>
                            </div>
                        }
                    </div>

                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public long Id { get; set; }

    private Guitarras? produto;
    private string _mensagemErro = "";
    private string tipoFreteSelecionado = "";
    private decimal valorFreteSelecionado = 0;

    // Variáveis da API de Frete
    private string cep = "";
    private bool loading = false;
    private RespostaApiFrete? resultadoFrete;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            produto = await ProdutosServices.GetProdutoByIdAsync(Id);
        }
        catch (Exception ex)
        {
            _mensagemErro = $"Erro ao carregar os detalhes: {ex.Message}";
        }
    }

    private async Task AdicionarAoCarrinho()
    {
        if (produto != null)
        {
            await CarrinhosServices.Adicionar(produto);
            Navigation.NavigateTo("/carrinho");
        }
    }

    // Método que consome a API compartilhada
    private async Task ConsultarFreteProdutoAsync()
    {
        if (string.IsNullOrWhiteSpace(cep)) return;

        string cepLimpo = cep.Replace("-", "").Trim();
        if (cepLimpo.Length != 8) return;

        loading = true;
        resultadoFrete = null;
        ResetarFrete();

        try
        {
            // Burlamos o bloqueio de SSL criando o handler local seguro igualzinho ao do produto
            using var handler = new HttpClientHandler
            {
                ServerCertificateCustomValidationCallback = (message, cert, chain, errors) => true
            };
            using var clientLocal = new HttpClient(handler);

            string urlSuaApi = $"https://localhost:7169/cep/{cepLimpo}";

            // Fazemos a chamada com o cliente local
            resultadoFrete = await clientLocal.GetFromJsonAsync<RespostaApiFrete>(urlSuaApi);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao buscar frete no carrinho: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void ResetarFrete()
    {
        tipoFreteSelecionado = ""; // Limpa se era PAC ou SEDEX
        valorFreteSelecionado = 0; // Zera o valor cobrado
    }
}